---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSiteSettings, languageFromPath } from "../lib/siteSettings";

// Pages that know their language pass it; the rest take it from the URL.
const { lang = languageFromPath(Astro.url.pathname) } = Astro.props;
const settings = await getSiteSettings(lang);

// The settings' SEO fields are the defaults for any page that does not set its own.
const {
  title = settings?.seo?.metaTitle || settings?.siteName || "Astro + Sanity Demo",
  description = settings?.seo?.metaDescription ||
    "A simple demo project using Astro and Sanity.",
} = Astro.props;
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Header lang={lang} settings={settings} />
    <main>
      <slot />
    </main>

    <Footer lang={lang} settings={settings} />
  </body>
</html>