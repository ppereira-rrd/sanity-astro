---
/**
 * The about page for one language. The studio keeps a single `aboutPage` document per
 * language under fixed IDs (`aboutPage-en`, `aboutPage-es`), so this reads that document
 * directly rather than searching for it.
 */
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Main from "../layouts/main.astro";
import Sections from "./Sections.astro";
import { ABOUT_PAGE_QUERY } from "../lib/queries";

interface Props {
  language: "en" | "es";
}

const { language } = Astro.props;

const about = await sanityClient.fetch<SanityDocument | null>(
  ABOUT_PAGE_QUERY,
  { id: `aboutPage-${language}` },
);
---

<Main
  lang={language}
  title={about?.seo?.metaTitle || about?.title || "About Us"}
  description={about?.seo?.metaDescription || ""}
>
  {
    about ? (
      <div class="py-16">
        <Sections sections={about.sections} />
      </div>
    ) : (
      <div class="min-h-screen flex items-center justify-center px-6 text-center">
        <p class="text-gray-600">
          The {language === "es" ? "Spanish " : ""}about page has not been
          created in Sanity yet.
        </p>
      </div>
    )
  }
</Main>
