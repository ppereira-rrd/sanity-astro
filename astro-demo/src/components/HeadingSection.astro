---
import { PortableText } from "astro-portabletext";

interface Props {
  heading?: string;
  headingLevel?: "h2" | "h3" | "h4" | "h5" | "h6";
  body?: any;
}

const {
  heading,
  headingLevel = "h2",
  body,
} = Astro.props;

const headingTag = headingLevel;
---

<section class="py-12 px-6">
  <div class="max-w-6xl mx-auto">

    {
      heading && (
        <>
          {headingTag === "h2" && (
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">
              {heading}
            </h2>
          )}

          {headingTag === "h3" && (
            <h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-6">
              {heading}
            </h3>
          )}

          {headingTag === "h4" && (
            <h4 class="text-xl md:text-2xl font-bold tracking-tight mb-5">
              {heading}
            </h4>
          )}

          {headingTag === "h5" && (
            <h5 class="text-lg md:text-xl font-bold tracking-tight mb-4">
              {heading}
            </h5>
          )}

          {headingTag === "h6" && (
            <h6 class="text-base md:text-lg font-bold tracking-tight mb-4">
              {heading}
            </h6>
          )}
        </>
      )
    }

    {
      Array.isArray(body) && (
        <div class="prose max-w-3xl">
          <PortableText value={body} />
        </div>
      )
    }

  </div>
</section>