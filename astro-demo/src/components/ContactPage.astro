---
/**
 * The contact page for one language. The studio keeps a single `contactPage` document per
 * language under fixed IDs (`contactPage-en`, `contactPage-es`), so this reads that document
 * directly rather than searching for it.
 */
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Main from "../layouts/main.astro";
import Sections from "./Sections.astro";
import { CONTACT_PAGE_QUERY } from "../lib/queries";

interface Props {
  language: "en" | "es";
}

const { language } = Astro.props;

const contact = await sanityClient.fetch<SanityDocument | null>(
  CONTACT_PAGE_QUERY,
  { id: `contactPage-${language}` },
);
---

<Main
  lang={language}
  title={contact?.seo?.metaTitle || contact?.title || "Contact Us"}
  description={contact?.seo?.metaDescription || ""}
>
  {
    contact ? (
      <div class="py-16">
        <Sections sections={contact.sections} />
      </div>
    ) : (
      <div class="min-h-screen flex items-center justify-center px-6 text-center">
        <p class="text-gray-600">
          The {language === "es" ? "Spanish " : ""}about page has not been
          created in Sanity yet.
        </p>
      </div>
    )
  }
</Main>
