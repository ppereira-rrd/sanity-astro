---
import { PortableText } from "astro-portabletext";

interface Props {
  heading?: string;
  text?: any;
  buttonText?: string;
  buttonUrl?: string;
}

const {
  heading,
  text,
  buttonText,
  buttonUrl,
} = Astro.props;
---

<section class="py-16 md:py-24 px-6">
  <div class="max-w-6xl mx-auto">

    <div class="rounded-xl border border-gray-200 p-8 md:p-12 text-center">

      {heading && (
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-5">
          {heading}
        </h2>
      )}

      {Array.isArray(text) && (
        <div class="prose max-w-2xl mx-auto mb-8">
          <PortableText value={text} />
        </div>
      )}

      {buttonText && buttonUrl && (
        <a
          href={buttonUrl}
          class="inline-block px-6 py-3 rounded-lg bg-purple-600 text-white font-semibold hover:bg-purple-800 transition"
        >
          {buttonText}
        </a>
      )}

    </div>

  </div>
</section>