---
// Header, with the site name and logo from the studio's Site Settings.
// Styled by Tailwind
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import {
  createImageUrlBuilder,
  type SanityImageSource,
} from "@sanity/image-url";

interface Props {
  lang: "en" | "es";
  settings: SanityDocument | null;
}

const { lang, settings } = Astro.props;

const { projectId, dataset } = sanityClient.config();
const logo =
  settings?.logo && projectId && dataset
    ? createImageUrlBuilder({ projectId, dataset })
        .image(settings.logo as SanityImageSource)
        .height(80)
        .url()
    : null;

const siteName = settings?.siteName || "Astro + Sanity";
const home = lang === "es" ? "/es" : "/";
const labels =
  lang === "es"
    ? { home: "Inicio", posts: "Artículos", attorneys: "Abogados" }
    : { home: "Home", posts: "Posts", attorneys: "Attorneys" };
const paths =
  lang === "es"
    ? { posts: "/es/articulos", attorneys: "/es/abogados" }
    : { posts: "/posts", attorneys: "/attorneys" };
---

<header class="border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-6 py-5">
    <div class="flex items-center justify-between">
      <a
        href={home}
        class="text-xl font-bold tracking-tight hover:text-purple-600 transition"
      >
        {
          logo ? (
            <img src={logo} alt={siteName} class="h-10 w-auto" />
          ) : (
            siteName
          )
        }
      </a>

      <nav class="flex items-center gap-6">
        <a href={home} class="text-gray-600 hover:text-purple-600 transition">
          {labels.home}
        </a>

        <a href={paths.posts} class="text-gray-600 hover:text-purple-600 transition">
          {labels.posts}
        </a>

        <a
          href={paths.attorneys}
          class="text-gray-600 hover:text-purple-600 transition"
        >
          {labels.attorneys}
        </a>
      </nav>
    </div>
  </div>
</header>
