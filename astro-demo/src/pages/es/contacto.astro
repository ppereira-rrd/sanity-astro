---
// The studio keeps one `contactPage` document per language under a fixed ID, so this reads
// `contactPage-es` directly rather than searching for it.
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Main from "../../layouts/main.astro";
import Sections from "../../components/Sections.astro";
import { CONTACT_PAGE_QUERY } from "../../lib/queries";

const contact = await sanityClient.fetch<SanityDocument | null>(CONTACT_PAGE_QUERY, {
  id: "contactPage-es",
});
---

<Main
  lang="es"
  title={contact?.seo?.metaTitle || contact?.title || "Contacto"}
  description={contact?.seo?.metaDescription || ""}
>
  {
    contact ? (
      <div class="py-16">
        <Sections sections={contact.sections} />
      </div>
    ) : (
      <div class="min-h-screen flex items-center justify-center px-6 text-center">
        <p class="text-gray-600">
          The Spanish contact page has not been created in Sanity yet.
        </p>
      </div>
    )
  }
</Main>
