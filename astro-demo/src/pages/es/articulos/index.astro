---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Main from "../../../layouts/main.astro";
import { POSTS_QUERY } from "../../../lib/queries";
import {
  createImageUrlBuilder,
  type SanityImageSource,
} from "@sanity/image-url";

const posts = await sanityClient.fetch<SanityDocument[]>(POSTS_QUERY, {
  language: "es",
});

const { projectId, dataset } = sanityClient.config();

const urlFor = (source: SanityImageSource) =>
  projectId && dataset
    ? createImageUrlBuilder({ projectId, dataset }).image(source)
    : null;
---

<Main
  lang="es"
  title="Artículos | Astro + Sanity"
  description="Una demostración sencilla de cómo funciona Astro con Sanity como CMS headless."
>
  <body>
    <main class="min-h-screen flex items-center justify-center px-6 py-16">
      <div class="max-w-3xl w-full">
        <div class="text-center mb-12">
          <p
            class="text-sm font-semibold uppercase tracking-widest text-purple-600 mb-4"
          >
            Sanity CMS
          </p>

          <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-6">
            Artículos
          </h1>

          <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
            Contenido administrado en Sanity y generado con Astro.
          </p>
        </div>

        {
          posts.length > 0 ? (
            <div class="grid gap-4">
              {posts.map((post) => (
                <a
                  href={`/es/articulos/${post.slug.current}`}
                  class="block p-6 rounded-xl border border-gray-200 hover:bg-gray-50 hover:shadow-md transition"
                >
                  <div class="flex items-center gap-5">
                    {post.featuredImage && (
                      <img
                        src={urlFor(post.featuredImage)
                          ?.width(320)
                          .height(320)
                          .url()}
                        alt={post.featuredImage.alt || post.title}
                        class="w-24 h-24 shrink-0 rounded-lg object-cover"
                        width="96"
                        height="96"
                        loading="lazy"
                      />
                    )}

                    <div class="min-w-0 flex-1">
                      <h2 class="text-xl font-semibold mb-2">{post.title}</h2>

                      <p class="text-sm text-gray-500">
                        {new Date(post.publishedAt).toLocaleDateString("es")}
                      </p>
                    </div>

                    <span class="text-purple-600 text-xl">→</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="p-8 rounded-xl border border-gray-200 text-center">
              <h2 class="text-xl font-semibold mb-2">Aún no hay artículos</h2>

              <p class="text-gray-600">
                Cree un artículo en Sanity y aparecerá aquí.
              </p>
            </div>
          )
        }

        <div class="text-center mt-10">
          <a href="/es" class="text-purple-600 underline hover:text-purple-800">
            ← Volver al inicio
          </a>
        </div>
      </div>
    </main>
  </body>
</Main>
