---
import Main from "../../layouts/main.astro";

import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import {
  createImageUrlBuilder,
  type SanityImageSource,
} from "@sanity/image-url";

import KeyTakeawaysSection from "../../components/KeyTakeawaysSection.astro";
import HeadingSection from "../../components/HeadingSection.astro";
import TextSection from "../../components/TextSection.astro";
import CtaSection from "../../components/CtaSection.astro";
import TestimonialSection from "../../components/TestimonialSection.astro";
import CaseResultSection from "../../components/CaseResultSection.astro";
import ButtonBlock from "../../components/ButtonBlock.astro";
import TableOfContents from "../../components/TableOfContents.astro";

import { tableOfContents } from "../../lib/headings";
import { POST_QUERY, POST_SLUGS_QUERY } from "../../lib/queries";

const post = await sanityClient.fetch<SanityDocument>(POST_QUERY, Astro.params);

export async function getStaticPaths(): Promise<
  { params: { slug: string } }[]
> {
  return await sanityClient.fetch(POST_SLUGS_QUERY);
}

const { projectId, dataset } = sanityClient.config();

const urlFor = (source: SanityImageSource) =>
  projectId && dataset
    ? createImageUrlBuilder({ projectId, dataset }).image(source)
    : null;

const postImageUrl = post.basic?.featuredImage
  ? urlFor(post.basic.featuredImage)?.width(900).height(500).url()
  : null;

const sections: any[] = Array.isArray(post.sections) ? post.sections : [];
const toc = tableOfContents(sections);
const headingIds = new Map(toc.map((item) => [item.key, item.id]));

// The contents list belongs directly above what it indexes, which puts it after the
// key takeaways and the lede. Spliced in as a section so the dispatch below stays flat.
const firstHeading = sections.findIndex((s) => s._type === "headingSection");
const rendered =
  toc.length > 1 && firstHeading >= 0
    ? [
        ...sections.slice(0, firstHeading),
        { _type: "tableOfContentsSection" },
        ...sections.slice(firstHeading),
      ]
    : sections;
---

<Main
  title={`${post.basic?.title || "Post"} | Astro + Sanity`}
  description={post.basic?.excerpt || ""}
>
  <main class="min-h-screen flex items-center justify-center px-6 py-16">
    <article class="max-w-3xl w-full">
      <a
        href="/posts"
        class="inline-block text-purple-600 underline hover:text-purple-800 mb-10"
      >
        ← Back to posts
      </a>

      <div class="text-center mb-10">
        <p
          class="text-sm font-semibold uppercase tracking-widest text-purple-600 mb-4"
        >
          Sanity CMS
        </p>

        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
          {post.basic?.title}
        </h1>

        {
          post.basic?.publishedAt && (
            <p class="text-gray-500">
              Published {new Date(post.basic.publishedAt).toLocaleDateString()}
              {post.basic?.author?.name && <> · By {post.basic.author.name}</>}
            </p>
          )
        }
      </div>

      {
        postImageUrl && (
          <img
            src={postImageUrl}
            alt={post.basic?.title || ""}
            class="w-full aspect-video object-cover rounded-xl mb-10"
            width="900"
            height="500"
          />
        )
      }

      {
        rendered.map((section: any) => {
          switch (section._type) {
            case "keyTakeawaysSection":
              return <KeyTakeawaysSection {...section} />;

            case "tableOfContentsSection":
              return <TableOfContents items={toc} title={section.heading} levels={section.headingLevels} />;

            case "headingSection":
              return (
                <HeadingSection {...section} id={headingIds.get(section._key)} />
              );

            case "textSection":
              return <TextSection {...section} />;

            case "ctaSection":
              return <CtaSection {...section} />;

            case "testimonialSection":
              return <TestimonialSection {...section} />;

            case "caseResultSection":
              return <CaseResultSection {...section} />;

            case "button":
              return <ButtonBlock {...section} />;

            default:
              return null;
          }
        })
      }

      {
        post.basic?.author?.bio && (
          <div class="mt-10 rounded-xl border border-gray-200 p-6">
            <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-purple-600">
              About the author
            </p>

            <p class="font-semibold">{post.basic.author.name}</p>
            <p class="mt-1 text-gray-600">{post.basic.author.bio}</p>
          </div>
        )
      }

      <div class="text-center mt-10">
        <a
          href="/posts"
          class="text-purple-600 underline hover:text-purple-800"
        >
          ← View all posts
        </a>
      </div>
    </article>
  </main>
</Main>
